# Copia este archivo como .env.local y completa los valores (.env.local no se versiona).
# El frontend lee una sola variable: VITE_API_URL, la URL base del backend sin barra final.
# Se usa en src/shared/api/axios.ts y en src/domains/public/repositories/PublicRepository.ts.
# Si queda vacía, las peticiones van al mismo origen del frontend y fallan: trátala como obligatoria.
# Vite la incrusta al compilar; después de cambiarla hay que reiniciar npm run dev o volver a compilar.

# Backend local (repositorio ecolima-backend, puerto 9000):
VITE_API_URL=http://127.0.0.1:9000

# Backend desplegado (en CI se inyecta desde el secreto VITE_API_URL del repositorio):
# VITE_API_URL=https://ecolimabackend-bcbmf4d9dufngddy.eastus2-01.azurewebsites.net
